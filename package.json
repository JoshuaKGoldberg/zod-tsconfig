{
	"name": "zod-tsconfig",
	"version": "0.3.1",
	"description": "Zod schemas for TypeScript's TSConfig properties. ⚙️",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/zod-tsconfig.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg ✨",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"tsc": "tsc"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.2",
		"create-typescript-app": "2.87.7",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.47.0",
		"prettier": "3.9.6",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=18.3.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
